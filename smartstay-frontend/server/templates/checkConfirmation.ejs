<!doctype html><html><head><meta charset="utf-8"/><title>Check-In Confirm</title><style>body{font-family:Arial;color:#111}.container{max-width:700px;margin:20px auto;padding:20px;background:#fff;border-radius:8px}</style></head><body>
  <div class="container">
    <% if (LOGO_URL) { %><img src="<%= LOGO_URL %>" style="width:64px;height:64px;object-fit:cover"/><% } %>
    <h2>Check-in Confirmation</h2>
    <p>Dear <%= booking.GuestName %>,</p>
    <p>Your check-in for <strong>Room <%= booking.RoomNumber %> (<%= booking.RoomType %>)</strong> has been confirmed. Check-in date: <%= booking.CheckInDate %>.</p>
    <p>Booking ID: <%= booking.BookingID %></p>
    <p>We look forward to hosting you.</p>
  </div>
</body></html>

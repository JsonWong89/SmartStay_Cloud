<!doctype html>
<html><head><meta charset="utf-8"/><title>Payment Invoice</title>
<style>body{font-family:Arial;color:#111}.container{max-width:700px;margin:20px auto;padding:20px;background:#fff;border-radius:8px}.row{display:flex;justify-content:space-between}.table{width:100%;border-collapse:collapse;margin-top:12px}.table th,.table td{padding:8px;border-bottom:1px solid #eee}</style></head>
<body>
  <div class="container">
    <% if (LOGO_URL) { %><img src="<%= LOGO_URL %>" style="width:80px;height:80px;object-fit:cover"/><% } %>
    <h2>Payment Invoice</h2>
    <p>Invoice #: <%= invoice.invoiceNo || 'INV-'+(invoice.bookingId||'') %></p>
    <div class="row">
      <div>
        <p><strong>Guest:</strong> <%= invoice.guestName %></p>
        <p><strong>Room:</strong> <%= invoice.room %></p>
      </div>
      <div>
        <p><strong>Date:</strong> <%= new Date().toLocaleString() %></p>
      </div>
    </div>
    <table class="table">
      <thead><tr><th>Item</th><th>Amount</th></tr></thead>
      <tbody>
        <% invoice.items.forEach(it => { %>
          <tr><td><%= it.desc %></td><td>RM <%= it.amount.toFixed(2) %></td></tr>
        <% }) %>
      </tbody>
    </table>
    <div style="text-align:right;font-weight:700;margin-top:12px">Total: RM <%= invoice.items.reduce((s,i)=>s+i.amount,0).toFixed(2) %></div>
  </div>
</body></html>
